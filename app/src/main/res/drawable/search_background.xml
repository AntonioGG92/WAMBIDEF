<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" /> <!-- Fondo blanco, puedes cambiar el color si es necesario -->
    <corners android:radius="16dp" /> <!-- Bordes redondeados -->
    <stroke
        android:width="2dp"
        android:color="#CCCCCC" /> <!-- Borde suave, puedes modificar el color -->
    <padding
        android:left="8dp"
        android:right="8dp"
        android:top="8dp"
        android:bottom="8dp"/>
</shape>
